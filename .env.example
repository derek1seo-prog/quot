# Optional: only needed to persist quotes and rate edits across Vercel's
# serverless instances. Without these, the app falls back to writing local
# JSON files (fine for local dev; on Vercel it falls back to /tmp, which is
# NOT shared between instances - saved quotes may 404 for other requests).
# This also means the daily exchange-rate cron job below needs these set to
# reliably reach the rest of the running app in production.
#
# Set these up in ~1 minute: Vercel dashboard -> your project -> Storage tab
# -> Create Database -> a Redis option (e.g. "Upstash for Redis") -> Connect
# to this project. Vercel then injects these automatically - you usually
# don't need to copy/paste them by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required to protect /api/cron/exchange-rate (see vercel.json), which
# refreshes the USD -> KRW rate every morning. Generate any random string
# (e.g. `openssl rand -hex 32`) and set it under Vercel Project Settings ->
# Environment Variables - Vercel then automatically sends it as the
# Authorization header on its own cron requests, so only the scheduled job
# (not an arbitrary caller) can trigger a refresh.
CRON_SECRET=

# Local dev only - not needed on Vercel. /api/quotes/[id]/pdf renders the
# print page with a real headless Chromium (via puppeteer-core) to produce
# a pixel-accurate PDF; on Vercel it uses @sparticuz/chromium's bundled
# binary automatically, but locally you need to point this at an installed
# Chrome/Chromium binary (e.g. /usr/bin/google-chrome or the path printed
# by `npx playwright install --dry-run chromium`) for the "PDF 다운로드"
# button to work in `npm run dev`.
PUPPETEER_EXECUTABLE_PATH=
