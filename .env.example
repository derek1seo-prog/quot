# Optional: only needed to persist quotes and rate edits across Vercel's
# serverless instances. Without these, the app falls back to writing local
# JSON files (fine for local dev; on Vercel it falls back to /tmp, which is
# NOT shared between instances - saved quotes may 404 for other requests).
#
# Set these up in ~1 minute: Vercel dashboard -> your project -> Storage tab
# -> Create Database -> a Redis option (e.g. "Upstash for Redis") -> Connect
# to this project. Vercel then injects these automatically - you usually
# don't need to copy/paste them by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
